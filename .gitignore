# ============================================
# Task Manager - Root .gitignore
# Covers both backend (Django) and frontend (React)
# ============================================

# Backend (Django)
backend/*.log
backend/*.pot
backend/*.pyc
backend/__pycache__/
backend/local_settings.py
backend/db.sqlite3
backend/db.sqlite3-journal
backend/media/
backend/staticfiles/
backend/.env
backend/.venv
backend/venv/
backend/env/

# Frontend (React / Node)
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/build/
frontend/dist/
frontend/coverage/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python (global)
*.pyc
__pycache__/
*.egg-info/
dist/
build/

# Node (global)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js